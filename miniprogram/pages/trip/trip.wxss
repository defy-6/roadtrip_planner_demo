.trip-head { display: grid; gap: 8rpx; }
.trip-title-line { display: flex; align-items: baseline; gap: 16rpx; }
.trip-title { font-size: 40rpx; font-weight: 600; }
.rename-link { font-size: 24rpx; color: #2f73a9; }
.share-line { display: flex; align-items: center; gap: 12rpx; }
.share-code { font-size: 34rpx; font-weight: 700; color: #2f73a9; letter-spacing: 4rpx; }
.share-toggle { margin-top: 12rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.schedule-tools { display: flex; justify-content: space-between; align-items: center; }
.weather-link { font-size: 24rpx; color: #2f73a9; padding: 8rpx 14rpx; border: 1rpx solid #b9c4d1; border-radius: 999rpx; }

.map-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.map-save { margin: 0; padding: 8rpx 26rpx; font-size: 24rpx; }

.segmented {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6rpx;
  padding: 6rpx; margin: 16rpx 0 4rpx;
  background: #eef1ec; border-radius: 14rpx;
}
.seg-item {
  text-align: center; padding: 14rpx 0; border-radius: 10rpx;
  font-size: 26rpx; color: #5a6472; font-weight: 600;
}
.seg-item.is-active { background: #fff; color: #075b43; box-shadow: 0 2rpx 8rpx rgba(7, 91, 67, 0.12); }

.date-strip { white-space: nowrap; padding: 4rpx 0 12rpx; }
.date-chip {
  display: inline-flex; flex-direction: column; align-items: center;
  padding: 12rpx 22rpx; margin-right: 12rpx;
  border: 1rpx solid #d6d9de; border-radius: 14rpx; background: #fff;
  font-size: 26rpx; font-weight: 600;
}
.date-chip .date-week { font-size: 20rpx; color: #8892a0; font-weight: 400; }
.date-chip.is-active { background: #075b43; color: #fff; border-color: #075b43; }
.date-chip.is-active .date-week { color: #dcefe6; }

.event-row {
  display: flex; align-items: flex-start; gap: 16rpx;
  border-left: 6rpx solid #b9c4d1; border-radius: 10rpx;
  background: #fff; padding: 16rpx 18rpx; margin-bottom: 12rpx;
}
.event-row.type-spot { border-left-color: #39775f; }
.event-row.type-food { border-left-color: #e36b32; }
.event-row.type-drive { border-left-color: #4385c8; }
.event-row.type-flight { border-left-color: #9168b0; }
.event-row.type-hotel { border-left-color: #9168b0; }
.event-row.type-transport { border-left-color: #4a7f8f; }
.event-row.type-fuel { border-left-color: #c8a438; }
.ev-time { min-width: 96rpx; display: grid; gap: 2rpx; }
.ev-time text { font-size: 24rpx; font-weight: 600; color: #1f2733; }
.ev-time .ev-end { color: #8892a0; font-size: 20rpx; font-weight: 400; }
.ev-main { flex: 1; min-width: 0; }
.ev-title { font-size: 28rpx; font-weight: 600; word-break: break-all; }
.ev-detail { margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ev-arrow { color: #b9c4d1; font-size: 32rpx; padding-top: 4rpx; }
.empty { text-align: center; padding: 40rpx 0; }

.add-btn {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 32rpx;
  height: 92rpx; border-radius: 46rpx;
  background: #075b43; color: #fff; font-size: 30rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(7, 91, 67, 0.28);
}

.trip-map { width: 100%; height: 56vh; border-radius: 16rpx; }
.map-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12rpx; text-align: center; }
.map-stat b { display: block; font-size: 30rpx; color: #075b43; }
.map-stat small { color: #8892a0; font-size: 22rpx; }
.map-hint { text-align: center; padding: 20rpx 0; }

.plan-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 22rpx; margin-bottom: 12rpx;
  border: 1rpx solid #e3e6ea; border-radius: 12rpx;
}
.plan-row.is-current { border-color: #075b43; background: #eef6f0; }
.plan-name { font-size: 28rpx; font-weight: 600; }
.plan-flag { color: #075b43; font-size: 22rpx; font-weight: 700; }
.plan-arrow { color: #b9c4d1; font-size: 30rpx; }
.plan-action { margin-top: 16rpx; }

.loc-toolbar { padding-bottom: 12rpx; }
.loc-types { white-space: nowrap; margin-top: 12rpx; }
.loc-type-chip {
  display: inline-block; padding: 10rpx 22rpx; margin-right: 10rpx;
  border: 1rpx solid #d6d9de; border-radius: 999rpx; background: #fff;
  font-size: 24rpx; color: #5a6472;
}
.loc-type-chip.is-active { background: #075b43; color: #fff; border-color: #075b43; }
.loc-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 6rpx; border-bottom: 1rpx solid #f0f2ed;
}
.loc-row:last-child { border-bottom: 0; }
.loc-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #b9c4d1; flex: 0 0 auto; }
.loc-row.type-spot .loc-dot { background: #39775f; }
.loc-row.type-food .loc-dot { background: #e36b32; }
.loc-row.type-hotel .loc-dot { background: #9168b0; }
.loc-row.type-shopping .loc-dot { background: #c8a438; }
.loc-row.type-fuel .loc-dot { background: #4a7f8f; }
.loc-row.type-service .loc-dot { background: #4385c8; }
.loc-row.type-flight .loc-dot { background: #7a5aa8; }
.loc-main { flex: 1; min-width: 0; }
.loc-name { font-size: 28rpx; font-weight: 600; word-break: break-all; }
