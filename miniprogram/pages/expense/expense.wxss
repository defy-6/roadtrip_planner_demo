.total-card { display: grid; justify-items: center; gap: 6rpx; }
.total { font-size: 56rpx; font-weight: 700; color: #075b43; }
.add-expense { margin-top: 16rpx; width: 70%; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.field { display: grid; gap: 8rpx; margin-bottom: 20rpx; }
.field-label { font-size: 24rpx; color: #5a6472; }
.picker-value { border: 1rpx solid #d6d9de; border-radius: 12rpx; padding: 16rpx 20rpx; background: #fff; font-size: 28rpx; }
.input { border: 1rpx solid #d6d9de; border-radius: 12rpx; padding: 16rpx 20rpx; background: #fff; }
.form-actions { display: grid; grid-template-columns: 1fr 2fr; gap: 20rpx; margin-top: 8rpx; }

.expense-day { margin-bottom: 24rpx; }
.expense-day:last-child { margin-bottom: 0; }
.expense-day-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.expense-day-total { font-size: 26rpx; font-weight: 600; color: #075b43; }
.expense-row {
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 6rpx; border-bottom: 1rpx solid #f0f2ed;
}
.expense-row:last-child { border-bottom: 0; }
.exp-main { flex: 1; min-width: 0; }
.exp-note { font-size: 28rpx; font-weight: 600; }
.exp-amount { font-size: 28rpx; font-weight: 700; }
.exp-edit { font-size: 24rpx; color: #2f73a9; padding: 6rpx 10rpx; }
.exp-del { font-size: 24rpx; color: #c0392b; padding: 6rpx 10rpx; }
.empty { text-align: center; padding: 60rpx 0; }
