.field { display: grid; gap: 8rpx; margin-bottom: 24rpx; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.field-label { font-size: 24rpx; color: #5a6472; }
.picker-value { border: 1rpx solid #d6d9de; border-radius: 12rpx; padding: 18rpx 20rpx; background: #fff; font-size: 28rpx; }
.type-badge { font-weight: 600; }
.type-badge.type-spot { color: #39775f; }
.type-badge.type-food { color: #e36b32; }
.type-badge.type-drive { color: #4385c8; }
.type-badge.type-flight, .type-badge.type-hotel { color: #9168b0; }
.input { border: 1rpx solid #d6d9de; border-radius: 12rpx; padding: 18rpx 20rpx; background: #fff; }
.textarea { min-height: 140rpx; }
.actions { display: grid; grid-template-columns: 1fr 2fr; gap: 20rpx; margin-top: 24rpx; }
