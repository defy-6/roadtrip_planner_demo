<view class="container">
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="card">
    <view class="field">
      <text class="field-label">类型</text>
      <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{types[typeIndex].label}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="input" placeholder="地点名称，例如：赛里木湖" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">地址</text>
      <input class="input" placeholder="地址（选填）" value="{{form.address}}" data-field="address" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <textarea class="input textarea" placeholder="备注（选填）" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <view class="card poi-card" wx:if="{{poiSummary}}">
    <view class="section-title">POI 信息（只读，来自高德）</view>
    <view class="poi-line" wx:if="{{poiSummary.openTime}}"><text class="poi-key">营业时间</text><text>{{poiSummary.openTime}}</text></view>
    <view class="poi-line" wx:if="{{poiSummary.rating}}"><text class="poi-key">评分</text><text>{{poiSummary.rating}}</text></view>
    <view class="poi-line" wx:if="{{poiSummary.referenceCost}}"><text class="poi-key">参考费用</text><text>{{poiSummary.referenceCost}}</text></view>
    <view class="poi-line" wx:if="{{poiSummary.ticketPrice}}"><text class="poi-key">门票</text><text>{{poiSummary.ticketPrice}}</text></view>
    <view class="poi-line" wx:if="{{poiSummary.tags}}"><text class="poi-key">标签</text><text>{{poiSummary.tags}}</text></view>
  </view>

  <view class="actions">
    <button class="btn-ghost" wx:if="{{!isNew}}" bindtap="remove" disabled="{{saving}}">删除</button>
    <button class="btn-primary" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
  </view>
</view>
