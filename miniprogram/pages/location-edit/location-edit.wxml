<view class="container">
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="card">
    <view class="field">
      <text class="field-label">类型</text>
      <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{types[typeIndex].label}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="input" placeholder="地点名称，例如：赛里木湖" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">地址</text>
      <input class="input" placeholder="地址（选填）" value="{{form.address}}" data-field="address" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <textarea class="input textarea" placeholder="备注（选填）" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <view class="actions">
    <button class="btn-ghost" wx:if="{{!isNew}}" bindtap="remove" disabled="{{saving}}">删除</button>
    <button class="btn-primary" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
  </view>
</view>
